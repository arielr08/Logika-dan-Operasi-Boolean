   "source": [
    "# Membuat input variabel dengan tipe data integer\n",
    "a = 10\n",
    "b = 20\n",
    "\n",
    "print(a + b)  # Output: 30\n",
    "print(a - b)  # Output: -10\n",
    "print(a * b)  # Output: 200\n",
    "print(a / b)  # Output: 0.5\n",
    "print(a % b)  # Output: 10\n",
    "print(a ** b) # Output: 100000000000000000000\n",
    "print(a // b) # Output: 0"
   ]
